#!/usr/bin/env bash
# verify [--regen] [--build]
#
#   --regen  rebuild the generated files first (needed whenever a codegen input
#            moved: lib/**.dart, swagger/*.json, pubspec.yaml, build.yaml)
#   --build  compile the Linux app as well — slower, and the only check that
#            proves the merge actually builds
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
export PATH="$HOME/opt/flutter/bin:$PATH"

REGEN=0; BUILD=0
for arg in "$@"; do
  case "$arg" in
    --regen) REGEN=1 ;;
    --build) BUILD=1 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

if ((REGEN)); then
  flutter pub get >/dev/null 2>&1 || { echo "PUB_GET_FAILED"; exit 3; }
  if ! dart run build_runner build --delete-conflicting-outputs >/tmp/fork-codegen.log 2>&1; then
    echo "CODEGEN_FAILED"; tail -20 /tmp/fork-codegen.log; exit 3
  fi
fi

if ! flutter analyze --no-fatal-infos >/tmp/fork-analyze.log 2>&1; then
  echo "ANALYZE_FAILED"; tail -20 /tmp/fork-analyze.log; exit 3
fi
# test/widget_test.dart is the `flutter create` boilerplate, unchanged since the
# initial commit: it taps a counter this app has never had, and has always
# failed. Running it would mean the suite can never pass, so it is skipped by
# name rather than the whole step being abandoned — anything upstream adds later
# is still picked up.
mapfile -t TESTS < <(git ls-files test | grep '_test\.dart$' | grep -v '^test/widget_test\.dart$')
if ((${#TESTS[@]})); then
  if ! flutter test "${TESTS[@]}" >/tmp/fork-test.log 2>&1; then
    echo "TEST_FAILED"; tail -20 /tmp/fork-test.log; exit 3
  fi
fi

if ((BUILD)); then
  if ! flutter build linux --release >/tmp/fork-build.log 2>&1; then
    echo "BUILD_FAILED"; tail -25 /tmp/fork-build.log; exit 3
  fi
  echo "VERIFIED (analyze, test, linux build)"
  exit 0
fi

echo "VERIFIED (analyze, test)"
